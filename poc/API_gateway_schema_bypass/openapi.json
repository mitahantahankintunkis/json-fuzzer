{
	"openapi": "3.0.3",
	"info": {
		"title": "OpenAPI scheme bypass",
		"version": "0.1.0"
	},
	"servers": [
		{
			"url": "http://localhost:8080"
		}
	],
	"paths": {
		"/api/login": {
			"post": {
				"operationId": "parseQ",
				"summary": "Parse POST request body json and return value under key 'q'",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"username": {
										"type": "string",
										"pattern": "^[a-zA-Z0-9-_]{4,18}$"
									},
									"password": {
										"type": "string",
										"pattern": "^\\S{8,32}$"
									}
								},
								"required": [ "username", "password" ]
							}
						}
					}
				},
				"responses": {
					"200": {
						"description": "Success"
					},
					"400": {
						"description": "Parse error"
					}
				}
			}
		}
	},
	"x-tyk-api-gateway": {
		"info": {
			"name": "JSON schema bypass POC gateway",
			"id": "schema-bypass",
			"state": {
				"active": true
			}
		},
		"middleware": {
			"operations": {
				"parseQ": {
					"validateRequest": {
						"enabled": true
					}
				}
			}
		},
		"upstream": {
			"url": "http://backend:8080"
		},
		"server": {
			"listenPath": {
				"value": "/",
				"strip": true
			}
		}
	}
}
